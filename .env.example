# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Database (Supabase + Prisma)
# Pooled connection — used by the app at runtime
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct connection — used by Prisma CLI for migrations
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ElevenLabs (voice reader + voice summarization)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Stripe (subscription billing — test mode keys to start)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PREMIUM=price_...

# Optional — used for Stripe redirect URLs (defaults to VERCEL_URL or localhost)
# NEXT_PUBLIC_APP_URL=https://brainiac-inky.vercel.app

# Clerk webhook (syncs User on signup; enforces beta invites)
CLERK_WEBHOOK_SECRET=whsec_...

# Admin (F-019 — Clerk userId of the app owner; gates /admin/*)
ADMIN_USER_ID=your_clerk_user_id_here

# Upstash Redis (rate limiting on AI/voice/feedback routes)
# Create a database at https://console.upstash.com, then copy the REST URL/token.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=...
